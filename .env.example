# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Camera ingestion ─────────────────────────────────────────────
# Required. Use a long random value and configure the same value in the vision worker.
VISION_API_KEY=

# Set to false before the first production run to keep demonstration history out.
SEED_DEMO_DATA=true
